# Скопируйте в .env.local (в git его нет).

# Адрес бэка для сервера Next, без слеша в конце. Пусто — сайт берёт демо-данные из src/data,
# форма заявки имитирует отправку. Браузер ходит в /api/ и /media/ через rewrites (next.config.ts).
# В rewrites и флаг демо адрес попадает при сборке: поменяли — пересоберите.
API_URL=http://localhost:8000

# Секрет для POST /api/revalidate: бэк зовёт его после правки в админке.
# Тот же, что BACKEND__FRONTEND__REVALIDATE_SECRET в root/.env. openssl rand -hex 32
REVALIDATE_SECRET=
