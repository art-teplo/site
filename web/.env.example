# Скопируйте в .env.local (в git его нет).

# Адрес бэка без слеша в конце. Пусто — сайт берёт демо-данные из src/data, форма заявки имитирует отправку.
# Вшивается при сборке: поменяли — пересоберите.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Секрет для POST /api/revalidate: бэк зовёт его после правки в админке.
# Тот же, что BACKEND__FRONTEND__REVALIDATE_SECRET в root/.env. openssl rand -hex 32
REVALIDATE_SECRET=
