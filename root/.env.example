# Шаблон .env для docker compose. Сам .env в git не попадает.
# Локально: cp .env.example .env — значения ниже годятся только для локалки.
# На сервере .env создаётся руками (chmod 600), все пароли и ключи — новые:
#   пароли:      openssl rand -hex 32   (только [a-f0-9]: они вставляются в URL)
#   SECRET_KEY:  openssl rand -base64 48
# Копию серверного .env держать в менеджере паролей.

# --- образы ---
# Тег образа из GHCR: main | sha-<7 символов> (5 последних версий). Deploy передаёт свой
IMAGE_TAG=main
NGINX_PORT=80

# --- Postgres ---
POSTGRES_DB=artteplo
POSTGRES_USER=artteplo
POSTGRES_PASSWORD=artteplo

# --- Redis ---
REDIS_PASSWORD=artteplo

# --- Django ---
BACKEND__SECRET_KEY=dev-secret-key-change-me
BACKEND__DEBUG=0
# Домены через запятую, без схемы
BACKEND__ALLOWED_HOSTS=localhost
# Со схемой: https://art-teplo.by — нужно для входа в админку за nginx
BACKEND__CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Пусто: браузер шлёт форму на /api/ своего домена (nginx, в разработке — rewrites Next).
# Нужно, только если фронт живёт на другом домене
BACKEND__CORS_ALLOWED_ORIGINS=
# Путь админки без слешей; на сервере — нестандартный
BACKEND__ADMIN_PATH=admin
BACKEND__WORKERS=2

# --- S3 (ActiveStorage, docs/stack.md) ---
# 0 — фото в контейнере, файлы заявок в томе private_media.
# 1 — фото в BUCKET_NAME (публичное чтение), файлы заявок в PRIVATE_BUCKET_NAME (закрыт)
BACKEND__S3__ENABLED=0
BACKEND__S3__ENDPOINT_URL=https://io.activecloud.com
BACKEND__S3__REGION_NAME=
BACKEND__S3__ACCESS_KEY_ID=
BACKEND__S3__SECRET_ACCESS_KEY=
BACKEND__S3__BUCKET_NAME=art-teplo-media
BACKEND__S3__PRIVATE_BUCKET_NAME=art-teplo-private
BACKEND__S3__CUSTOM_DOMAIN=
BACKEND__S3__LOCATION=

# --- Бэкап базы (root/backup.sh, cron на сервере) — те же ключи, что у S3 ---
BACKUP__S3_BUCKET=art-teplo-backup

# --- Заявки и Telegram ---
# Адрес сайта со схемой — для ссылки «Открыть в админке» в сообщении
BACKEND__PUBLIC_URL=http://localhost:8080
# Адрес фронта — для ссылки «Открыть товар на сайте». Пусто — как PUBLIC_URL.
# Telegram не делает ссылками адреса localhost: проверять локально через
# lvh.me (смотрит на 127.0.0.1), например http://lvh.me:3000
BACKEND__SITE_URL=http://localhost:3000
# Токен из @BotFather. Локально — отдельный тестовый бот: один токен нельзя
# опрашивать из двух мест. Пусто — уведомления выключены, бот спит
BACKEND__TELEGRAM__BOT_TOKEN=
# id закрытой группы менеджеров: напишите /chatid в группе, бот ответит
BACKEND__TELEGRAM__CHAT_ID=
# Срок хранения заявок и файлов, дней (Закон РБ № 99-З)
BACKEND__LEADS__RETENTION_DAYS=365

# --- Контент: обновление страниц фронта после правки в админке ---
# POST сюда с тегом раздела; пусто — http://web:3000/api/revalidate (контейнер фронта, как на сервере).
# Локально Next запущен на хосте: http://host.docker.internal:3000/api/revalidate
BACKEND__FRONTEND__REVALIDATE_URL=
# Тот же секрет получает контейнер web; локально — REVALIDATE_SECRET в web/.env.local. openssl rand -hex 32
BACKEND__FRONTEND__REVALIDATE_SECRET=
